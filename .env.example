# =============================================================================
# SAGE — Plantilla de Variables de Entorno (.env.example)
# Proyecto: Sistema Agrícola de Genética Evolutiva
# Fecha de línea base: 2026-11-23 | Versión: 1.0.0
# Copiar a .env para uso local. NUNCA versionar .env ni credenciales reales.
# =============================================================================

# --- Identificación y modo de ejecución ---
SAGE_ENV=development
SAGE_LOG_LEVEL=INFO
SAGE_FAIL_FAST=true

# --- Rutas de catálogos sintéticos y salidas (aprobado en D-0002 / D02) ---
SAGE_CONFIG_PATH=config/environment.example.yaml
SAGE_DATA_DIR=05_DATA/reference
SAGE_CROPS_CATALOG_PATH=05_DATA/reference/crops_catalog.json
SAGE_ENV_PARAMS_PATH=05_DATA/reference/env_params.json
SAGE_PARCELS_INPUT_PATH=05_DATA/reference/parcels_input.json
SAGE_OUTPUT_DIR=11_OUTPUTS

# --- Reproducibilidad experimental ---
SAGE_DEFAULT_SEED=42
SAGE_DATA_VINTAGE=2026-11-23

# --- Parámetros de seguridad local (sin secretos reales; reemplazar solo si aplica en D02+) ---
SAGE_LOCAL_API_TOKEN=CHANGE_ME
SAGE_EXPORT_SIGNING_SALT=CHANGE_ME
